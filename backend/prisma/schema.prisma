// Traveldesk — enterprise SaaS data model (SQLite via Prisma).
//
// NOTE: SQLite has no native enums / arrays / JSON columns, so those are stored
// as strings (validated in the application layer with Zod) and Stringified JSON.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenancy, identity & access
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  legalName      String?
  gstin          String?
  supportEmail   String?
  phone          String?
  address        String?
  currency       String   @default("INR")
  financialYear  String   @default("April – March")
  timezone       String   @default("Asia/Kolkata")
  plan           String   @default("enterprise")
  planStatus     String   @default("active") // active | trialing | past_due | cancelled
  settings       String   @default("{}") // JSON: tax regime, invoice prefix, security prefs...
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branches       Branch[]
  memberships    Membership[]
  roles          Role[]
  records        Record[]
  tasks          Task[]
  customFields   CustomField[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  conversations  Conversation[]
  templates      MessageTemplate[]
  workflows      Workflow[]
  integrations   IntegrationConnection[]
  webhooks       Webhook[]
  savedReports   SavedReport[]
  aiMessages     AiMessage[]
  subscription   Subscription?
  usage          UsageRecord[]
  attachments    Attachment[]
  apiKeys        ApiKey[]
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  phone           String?
  avatarUrl       String?
  isPlatformAdmin Boolean   @default(false)
  active          Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships     Membership[]
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  aiMessages      AiMessage[]
  tasks           Task[]             @relation("TaskOwner")
  records         Record[]           @relation("RecordOwner")
  attachments     Attachment[]
  savedReports    SavedReport[]
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  roleKey        String   @default("company_admin")
  branchId       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  name           String
  description    String?
  permissions    String   @default("{}") // JSON: { "leads": ["view","create"], ... }
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  prefix         String    @unique
  keyHash        String    @unique
  scopes         String    @default("[]") // JSON array
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Org structure
// ─────────────────────────────────────────────────────────────────────────────

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String?
  address        String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  records        Record[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Workspace records — the generic entity behind all 24 CRM/ERP modules.
// The module catalogue + tabs live in the application layer (src/domain/modules.ts).
// ─────────────────────────────────────────────────────────────────────────────

model Record {
  id             String    @id @default(cuid())
  organizationId String
  moduleId       String
  tab            String?
  reference      String
  name           String
  detail         String    @default("")
  destination    String    @default("")
  ownerId        String?
  ownerName      String    @default("")
  branchId       String?
  branchName     String    @default("")
  date           String    @default("")
  amount         Float     @default(0)
  status         String    @default("Pending")
  email          String    @default("")
  phone          String    @default("")
  source         String    @default("Website")
  notes          String    @default("")
  extra          String    @default("{}") // JSON: custom field values
  meta           String    @default("{}") // JSON: module-specific extras
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  owner          User?        @relation("RecordOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([organizationId, reference])
  @@index([organizationId, moduleId])
  @@index([organizationId, status])
  @@index([organizationId, date])
  @@index([organizationId, ownerId])
}

model Task {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  type           String    @default("Sales follow-up")
  ownerId        String?
  ownerName      String    @default("")
  date           String
  priority       String    @default("Normal")
  done           Boolean   @default(false)
  relatedModule  String?
  relatedRecordId String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User?        @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([organizationId, date])
  @@index([organizationId, done])
}

model CustomField {
  id             String   @id @default(cuid())
  organizationId String
  moduleId       String
  key            String
  label          String
  type           String   @default("text") // text | number | date | select
  options        String   @default("[]")   // JSON array (for select)
  required       Boolean  @default(false)
  position       Int      @default(0)
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleId, key])
  @@index([organizationId, moduleId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  actorName      String   @default("System")
  action         String   // Created | Updated | Deleted | Login | Export | ...
  moduleId       String   @default("")
  recordId       String   @default("")
  label          String   @default("")
  meta           String   @default("{}") // JSON
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, moduleId])
  @@index([organizationId, recordId])
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String?
  title          String
  body           String    @default("")
  moduleId       String?
  recordId       String?
  level          String    @default("info") // info | warning | danger | success
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, readAt])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Communications (shared inbox)
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id             String    @id @default(cuid())
  organizationId String
  channel        String    @default("Shared inbox")
  contactName    String
  contactEmail   String    @default("")
  contactPhone   String    @default("")
  recordId       String?
  subject        String    @default("")
  status         String    @default("Open")
  assignedTo     String?
  lastMessageAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@index([organizationId, status])
  @@index([organizationId, channel])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  direction      String   @default("in") // in | out
  channel        String   @default("Shared inbox")
  body           String
  templateId     String?
  sentById       String?
  sentByName     String   @default("")
  meta           String   @default("{}")
  createdAt      DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model MessageTemplate {
  id             String   @id @default(cuid())
  organizationId String
  channel        String   @default("Shared inbox")
  name           String
  body           String
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, channel])
}

// ─────────────────────────────────────────────────────────────────────────────
// Automation
// ─────────────────────────────────────────────────────────────────────────────

model Workflow {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  moduleId       String    @default("leads")
  trigger        String
  condition      String    @default("All records")
  action         String
  status         String    @default("Active") // Active | Paused
  runCount       Int       @default(0)
  lastRunAt      DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs           WorkflowRun[]

  @@index([organizationId, status])
}

model WorkflowRun {
  id          String    @id @default(cuid())
  workflowId  String
  status      String    @default("success") // success | failed | skipped
  trigger     String    @default("")
  log         String    @default("")
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, startedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Integrations & webhooks
// ─────────────────────────────────────────────────────────────────────────────

model IntegrationConnection {
  id             String    @id @default(cuid())
  organizationId String
  provider       String
  category       String    @default("supplier") // supplier | business | payment | gds
  environment    String    @default("Sandbox")
  status         String    @default("Not connected")
  description    String    @default("")
  config         String    @default("{}")
  connectedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId])
}

model Webhook {
  id             String    @id @default(cuid())
  organizationId String
  url            String
  events         String    @default("[]") // JSON array
  secret         String
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries     WebhookDelivery[]

  @@index([organizationId])
}

model WebhookDelivery {
  id            String   @id @default(cuid())
  webhookId     String
  event         String
  status        String   @default("pending") // pending | success | failed
  responseCode  Int?
  payload       String   @default("{}")
  createdAt     DateTime @default(now())

  webhook       Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Reporting & AI
// ─────────────────────────────────────────────────────────────────────────────

model SavedReport {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  moduleId       String   @default("reports")
  filters        String   @default("{}")
  createdById    String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model AiMessage {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  conversationId String   @default("default")
  role           String   // user | assistant
  content        String
  model          String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, conversationId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// SaaS billing & usage
// ─────────────────────────────────────────────────────────────────────────────

model Plan {
  key          String  @id
  name         String
  priceMonthly Float   @default(0)
  priceYearly  Float   @default(0)
  currency     String  @default("INR")
  features     String  @default("[]")
  limits       String  @default("{}") // { "seats": 25, "branches": 5, "bookings": 1000 }
  popular      Boolean @default(false)
  position     Int     @default(0)

  subscriptions Subscription[]
}

model Subscription {
  id                 String   @id @default(cuid())
  organizationId     String   @unique
  planKey            String
  status             String   @default("active")
  billingCycle       String   @default("Yearly")
  seats              Int      @default(5)
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan               Plan         @relation(fields: [planKey], references: [key])

  @@index([planKey])
}

model UsageRecord {
  id             String   @id @default(cuid())
  organizationId String
  metric         String   // bookings | seats | branches | api_calls | messages
  value          Int      @default(0)
  period         String   // yyyy-MM
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metric, period])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Files
// ─────────────────────────────────────────────────────────────────────────────

model Attachment {
  id             String   @id @default(cuid())
  organizationId String
  moduleId       String?
  recordId       String?
  filename       String
  storedName     String
  mimeType       String   @default("application/octet-stream")
  size           Int      @default(0)
  uploadedById   String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy     User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId, moduleId])
  @@index([organizationId, recordId])
}
