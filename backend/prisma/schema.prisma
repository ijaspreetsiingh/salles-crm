// Traveldesk — enterprise SaaS data model.
//
// DATABASE PROVIDER is controlled by the DATABASE_URL env var.
// For local dev SQLite is fine; for production use PostgreSQL.
//
// To switch to PostgreSQL:
//   1. Set DATABASE_URL=postgres://... in .env
//   2. Run: npm run db:pg   (updates this file automatically)
//   3. Run: npm run db:migrate
//
// SQLite note: enums / arrays / JSON columns are stored as strings
// (validated in the application layer with Zod).

generator client {
  provider      = "prisma-client-js"
  // Generates both SQLite and Postgres query engines when building in Docker
  // so the same image can boot against either database.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenancy, identity & access
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  customDomain  String?  @unique // White-label domain e.g. crm.yourtravelagency.com
  legalName     String?
  gstin         String?
  supportEmail  String?
  phone         String?
  address       String?
  currency      String   @default("INR")
  financialYear String   @default("April – March")
  timezone      String   @default("Asia/Kolkata")
  language      String   @default("en") // en | hi | es | fr | ar
  plan          String   @default("enterprise")
  planStatus    String   @default("active") // active | trialing | past_due | cancelled
  settings      String   @default("{}") // JSON: tax regime, invoice prefix, security prefs...
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branches      Branch[]
  memberships   Membership[]
  roles         Role[]
  records       Record[]
  tasks         Task[]
  customFields  CustomField[]
  auditLogs     AuditLog[]
  notifications Notification[]
  conversations Conversation[]
  templates     MessageTemplate[]
  callLogs      CallLog[]
  consents      ConsentRecord[]
  workflows     Workflow[]
  integrations  IntegrationConnection[]
  webhooks      Webhook[]
  savedReports  SavedReport[]
  aiMessages    AiMessage[]
  subscription  Subscription?
  usage         UsageRecord[]
  attachments   Attachment[]
  apiKeys       ApiKey[]
  outbox        EmailOutbox[]
  payments      Payment[]
  payables      Payable[]
  expenses      Expense[]
  hotelRates    HotelRate[]
  campaigns     Campaign[]
  sequences     Sequence[]
  attendance    Attendance[]
  creditNotes   CreditNote[]
  groupMembers  GroupMember[]
  recordRelations RecordRelation[]
  recordEvents  RecordEvent[]
  savedViews    SavedView[]
  favorites     Favorite[]
  preferences   Preference[]
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  phone           String?
  avatarUrl       String?
  isPlatformAdmin Boolean   @default(false)
  active          Boolean   @default(true)
  emailVerified   Boolean   @default(false)
  /// Bumped whenever every existing session must stop working (password
  /// change, deactivation, role change). Access tokens carry the version they
  /// were minted with; a stale token is rejected.
  tokenVersion    Int       @default(0)
  /// Base32 TOTP secret. Set as soon as enrolment starts.
  twoFactorSecret String?
  /// When set, the account is protected by TOTP.
  twoFactorEnabledAt DateTime?
  /// SHA-256 hashes of one-time recovery codes (JSON array).
  twoFactorRecoveryCodes String @default("[]")
  lastLoginAt     DateTime?
  /// Running count of failed sign-in attempts since the last success.
  loginAttempts   Int       @default(0)
  /// When set, the account is locked until this time (account lockout policy).
  lockedUntil     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships   Membership[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  notifications Notification[]
  aiMessages    AiMessage[]
  tasks         Task[]         @relation("TaskOwner")
  records       Record[]       @relation("RecordOwner")
  attachments   Attachment[]
  savedReports  SavedReport[]
  savedViews    SavedView[]
  favorites     Favorite[]
  preferences   Preference[]
  recordEvents  RecordEvent[]
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  roleKey        String   @default("company_admin")
  branchId       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  name           String
  description    String?
  permissions    String   @default("{}") // JSON: { "leads": ["view","create"], ... }
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  prefix         String    @unique
  keyHash        String    @unique
  scopes         String    @default("[]") // JSON array
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Org structure
// ─────────────────────────────────────────────────────────────────────────────

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String?
  address        String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  records      Record[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Workspace records — the generic entity behind all 24 CRM/ERP modules.
// The module catalogue + tabs live in the application layer (src/domain/modules.ts).
// ─────────────────────────────────────────────────────────────────────────────

model Record {
  id             String    @id @default(cuid())
  organizationId String
  moduleId       String
  tab            String?
  reference      String
  name           String
  detail         String    @default("")
  destination    String    @default("")
  ownerId        String?
  ownerName      String    @default("")
  branchId       String?
  branchName     String    @default("")
  date           String    @default("")
  amount         Decimal   @default(0) @db.Decimal(14, 2)
  currency       String    @default("") // ISO code; empty = organisation default
  status         String    @default("Pending")
  email          String    @default("")
  phone          String    @default("")
  source         String    @default("Website")
  notes          String    @default("")
  extra          String    @default("{}") // JSON: custom field values
  meta           String    @default("{}") // JSON: module-specific extras
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  owner        User?         @relation("RecordOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  /// Delegates hang off this record (groups module); purging it removes them.
  groupMembers GroupMember[]

  @@unique([organizationId, reference])
  @@index([organizationId, moduleId])
  @@index([organizationId, status])
  @@index([organizationId, date])
  @@index([organizationId, ownerId])
  // Trigram indexes: the workspace search uses ILIKE '%term%', which a btree
  // index cannot serve. Without these every keystroke scans the whole tenant.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([detail(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([destination(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([notes(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([reference(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Atomic, gap-free reference counter per organisation and module.
///
/// Replaces the O(n) "load every record and find the highest number" scan
/// that was prone to duplicate references under concurrent writes. Each
/// create atomically increments the counter inside a transaction that
/// locks the organisation row, so two users creating a record in the same
/// millisecond always get distinct references.
model Sequence {
  id             String   @id @default(cuid())
  organizationId String
  moduleId       String
  /// Prefix-less stem for invoice series (e.g. "INV-26-27-"). Empty for generic module references.
  stem           String   @default("")
  lastNumber     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleId, stem])
  @@index([organizationId])
}

model Task {
  id              String   @id @default(cuid())
  organizationId  String
  title           String
  type            String   @default("Sales follow-up")
  ownerId         String?
  ownerName       String   @default("")
  date            String
  priority        String   @default("Normal")
  done            Boolean  @default(false)
  relatedModule   String?
  relatedRecordId String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([organizationId, date])
  @@index([organizationId, done])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
}

model CustomField {
  id             String   @id @default(cuid())
  organizationId String
  moduleId       String
  key            String
  label          String
  type           String   @default("text") // text | number | date | select
  options        String   @default("[]") // JSON array (for select)
  required       Boolean  @default(false)
  position       Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleId, key])
  @@index([organizationId, moduleId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  actorName      String   @default("System")
  action         String // Created | Updated | Deleted | Login | Export | ...
  moduleId       String   @default("")
  recordId       String   @default("")
  label          String   @default("")
  meta           String   @default("{}") // JSON
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, moduleId])
  @@index([organizationId, recordId])
  @@index([label(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String?
  title          String
  body           String    @default("")
  moduleId       String?
  recordId       String?
  level          String    @default("info") // info | warning | danger | success
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, readAt])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Communications (shared inbox)
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id             String   @id @default(cuid())
  organizationId String
  channel        String   @default("Shared inbox")
  contactName    String
  contactEmail   String   @default("")
  contactPhone   String   @default("")
  recordId       String?
  subject        String   @default("")
  status         String   @default("Open")
  assignedTo     String?
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([organizationId, status])
  @@index([organizationId, channel])
  @@index([contactName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([contactEmail(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  direction      String   @default("in") // in | out
  channel        String   @default("Shared inbox")
  body           String
  templateId     String?
  sentById       String?
  sentByName     String   @default("")
  meta           String   @default("{}")
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model MessageTemplate {
  id             String   @id @default(cuid())
  organizationId String
  channel        String   @default("Shared inbox")
  name           String
  body           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, channel])
}

/// A logged phone call - who was called, on which number, for how long and
/// what came out of it. Real sales teams live in this list.
model CallLog {
  id              String   @id @default(cuid())
  organizationId  String
  contactName     String
  contactPhone    String   @default("")
  direction       String   @default("Outbound") // Inbound | Outbound
  outcome         String   @default("Connected")
  durationMinutes Int      @default(0)
  notes           String   @default("")
  recordId        String?
  ownerName       String   @default("")
  calledById      String?
  calledAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, calledAt])
  @@index([organizationId, outcome])
}

/// What a customer agreed to be contacted on - email, WhatsApp, calls.
/// Kept per email address so the consent trail survives record edits.
model ConsentRecord {
  id             String   @id @default(cuid())
  organizationId String
  contactEmail   String
  contactPhone   String   @default("")
  contactName    String   @default("")
  email          Boolean  @default(false)
  whatsapp       Boolean  @default(false)
  calls          Boolean  @default(false)
  source         String   @default("Direct")
  capturedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, contactEmail])
  @@index([organizationId, updatedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Automation
// ─────────────────────────────────────────────────────────────────────────────

model Workflow {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  moduleId       String    @default("leads")
  trigger        String
  condition      String    @default("All records")
  action         String
  /// Visual builder graph: JSON {nodes, edges} from the automation canvas.
  graph          String    @default("")
  status         String    @default("Active") // Active | Paused
  runCount       Int       @default(0)
  lastRunAt      DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         WorkflowRun[]

  @@index([organizationId, status])
}

model WorkflowRun {
  id         String    @id @default(cuid())
  workflowId String
  status     String    @default("success") // success | failed | skipped | dead
  trigger    String    @default("")
  log        String    @default("")
  /// Attempts made so far; the first try counts as one.
  attempts   Int       @default(1)
  /// When the next automatic retry is due. Null means nothing is pending.
  nextAttemptAt DateTime?
  /// Set when retries ran out: a person has to look at this one.
  deadLetteredAt DateTime?
  /// JSON of the triggering event, so a retry can replay the same record.
  context    String    @default("{}")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, startedAt])
  @@index([status, nextAttemptAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Integrations & webhooks
// ─────────────────────────────────────────────────────────────────────────────

model IntegrationConnection {
  id             String    @id @default(cuid())
  organizationId String
  provider       String
  category       String    @default("supplier") // supplier | business | payment | gds
  environment    String    @default("Sandbox")
  status         String    @default("Not connected")
  description    String    @default("")
  config         String    @default("{}")
  connectedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId])
}

model Webhook {
  id             String   @id @default(cuid())
  organizationId String
  url            String
  events         String   @default("[]") // JSON array
  secret         String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  webhookId    String
  event        String
  status       String   @default("pending") // pending | success | failed
  responseCode Int?
  payload      String   @default("{}")
  /// Idempotency key for the source event, so a retried job never sends twice.
  dedupeKey    String?
  /// How many delivery attempts have been made (drives backoff).
  attempts     Int      @default(0)
  /// When the next automatic retry is due.
  nextAttemptAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@unique([webhookId, dedupeKey])
  @@index([webhookId, createdAt])
  @@index([status, nextAttemptAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Reporting & AI
// ─────────────────────────────────────────────────────────────────────────────

model SavedReport {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  moduleId       String   @default("reports")
  filters        String   @default("{}")
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model AiMessage {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  conversationId String   @default("default")
  role           String // user | assistant
  content        String
  model          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, conversationId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// SaaS billing & usage
// ─────────────────────────────────────────────────────────────────────────────

model Plan {
  key          String  @id
  name         String
  priceMonthly Decimal @default(0) @db.Decimal(14, 2)
  priceYearly  Decimal @default(0) @db.Decimal(14, 2)
  currency     String  @default("INR")
  features     String  @default("[]")
  limits       String  @default("{}") // { "seats": 25, "branches": 5, "bookings": 1000 }
  popular      Boolean @default(false)
  position     Int     @default(0)

  subscriptions Subscription[]
}

model Subscription {
  id                 String    @id @default(cuid())
  organizationId     String    @unique
  planKey            String
  status             String    @default("active")
  billingCycle       String    @default("Yearly")
  seats              Int       @default(5)
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planKey], references: [key])

  @@index([planKey])
}

model UsageRecord {
  id             String   @id @default(cuid())
  organizationId String
  metric         String // bookings | seats | branches | api_calls | messages
  value          Int      @default(0)
  period         String // yyyy-MM
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metric, period])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Files
// ─────────────────────────────────────────────────────────────────────────────

model Attachment {
  id             String   @id @default(cuid())
  organizationId String
  moduleId       String?
  recordId       String?
  filename       String
  storedName     String
  mimeType       String   @default("application/octet-stream")
  size           Int      @default(0)
  /// Which scanner saw this file — "clamav:clean" or "eicar-only:clean".
  /// Empty on rows uploaded before scanning existed.
  scanStatus     String   @default("")
  scannedAt      DateTime?
  uploadedById   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId, moduleId])
  @@index([organizationId, recordId])
}

model EmailOutbox {
  id               String    @id @default(cuid())
  organizationId   String
  channel          String    @default("email") // email | whatsapp
  to               String
  subject          String    @default("")
  body             String    @default("")
  template         String?
  status           String    @default("queued") // queued | sent | failed
  error            String?
  providerRef      String?
  userId           String?
  relatedModule    String?
  relatedReference String    @default("")
  createdAt        DateTime  @default(now())
  sentAt           DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model Payment {
  id                  String    @id @default(cuid())
  organizationId      String
  /// The module the money belongs to: "finance" (invoice) or "bookings".
  moduleId            String    @default("finance")
  recordReference     String    @default("")
  /// "payment" (money in) or "refund" (money returned to the customer).
  kind                String    @default("payment")
  /// Human receipt number, e.g. RCP-0007.
  receiptNo           String?
  /// Bank UTR, cheque number or provider payment id typed by the team.
  referenceNo         String    @default("")
  note                String    @default("")
  amount              Decimal   @default(0) @db.Decimal(14, 2)
  currency            String    @default("INR")
  method              String    @default("Razorpay")
  /// The date the money actually moved (not the date it was typed).
  paidOn              DateTime?
  createdById         String?
  status              String    @default("created") // created | paid | failed
  provider            String    @default("razorpay")
  providerOrderId     String?
  providerPaymentId   String?
  signature           String?
  checkoutUrl         String?
  paidAt              DateTime?
  /// JSON blob for reconciliation data, portal link, etc.
  meta                String    @default("{}")
  /// Human-readable invoice reference (e.g. INV-2024-001)
  reference           String    @default("")
  /// Razorpay short payment link URL (stored after first generation)
  razorpayPaymentLink String?
  createdAt           DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, receiptNo])
  @@unique([organizationId, providerPaymentId])
  @@index([organizationId, status])
  @@index([organizationId, recordReference])
  @@index([organizationId, moduleId, recordReference])
}

/// Money the agency owes a supplier: hotels, airlines, DMCs, guides.
/// A payable is a bill, not a booking — one trip can carry several.
model Payable {
  id               String    @id @default(cuid())
  organizationId   String
  supplierName     String    @default("")
  /// The supplier's GSTIN. Required to claim input credit in GSTR-3B.
  supplierGstin    String    @default("")
  /// Optional link to a record in the suppliers module.
  supplierRecordId String?
  /// Booking or invoice this cost belongs to, e.g. BK-2401.
  reference        String    @default("")
  description      String    @default("")
  amount           Decimal   @default(0) @db.Decimal(14, 2)
  currency         String    @default("INR")
  /// GST rate on the supplier bill; the tax split is derived from it.
  gstRate          Decimal   @default(0) @db.Decimal(5, 2)
  dueDate          DateTime?
  status           String    @default("due") // due | partial | paid
  notes            String    @default("")
  /// Three-way match: purchase order → goods received note → supplier invoice.
  /// All three amounts must agree before finance releases a payment.
  poNumber         String    @default("")
  poAmount         Decimal?  @db.Decimal(14, 2)
  receivedAmount   Decimal?  @db.Decimal(14, 2)
  invoiceNumber    String    @default("")
  invoiceAmount    Decimal?  @db.Decimal(14, 2)
  /// unmatched | matched | variance | missing_po | missing_grn
  matchStatus      String    @default("unmatched")
  matchNote        String    @default("")
  matchedAt        DateTime?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     PayablePayment[]

  @@index([organizationId, status])
  @@index([organizationId, dueDate])
}

/// Running costs of the agency itself: rent, salaries, ads, software.
/// Supplier bills live in Payable; this is everything else that leaves the bank.
model Expense {
  id             String    @id @default(cuid())
  organizationId String
  category       String    @default("Other")
  vendor         String    @default("")
  /// The vendor's GSTIN, when the bill carries one. Needed for input credit.
  vendorGstin    String    @default("")
  description    String    @default("")
  amount         Decimal   @default(0) @db.Decimal(14, 2)
  currency       String    @default("INR")
  gstRate        Decimal   @default(0) @db.Decimal(5, 2)
  spentOn        DateTime?
  method         String    @default("Bank transfer")
  referenceNo    String    @default("")
  notes          String    @default("")
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, spentOn])
  @@index([organizationId, category])
}

/// A negotiated room rate for one hotel, room type, meal plan and season.
///
/// Costing a package by hand is where agencies lose money, so each rate keeps
/// the supplier cost and the selling price side by side, in one currency, with
/// the validity window and the cancellation rule that goes with it.
model HotelRate {
  id             String    @id @default(cuid())
  organizationId String
  hotelName      String
  city           String    @default("")
  country        String    @default("")
  roomType       String    @default("Standard")
  mealPlan       String    @default("EP") // EP | CP | MAP | AP
  season         String    @default("All year")
  validFrom      String?
  validTo        String?
  costPrice      Decimal   @default(0) @db.Decimal(14, 2)
  sellingPrice   Decimal   @default(0) @db.Decimal(14, 2)
  currency       String    @default("INR")
  /// Per room per night | per person per night | per room per stay
  basis          String    @default("Per room per night")
  cancellation   String    @default("")
  supplierName   String    @default("")
  notes          String    @default("")
  active         Boolean   @default(true)
  createdById    String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, hotelName])
  @@index([organizationId, city])
  @@index([organizationId, active])
}

/// Daily attendance for the travel desk. One row per teammate per day, with
/// the first check-in and last check-out; totals are derived, never stored.
model Attendance {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  userName       String   @default("")
  /// Local calendar day, YYYY-MM-DD.
  date           String
  checkIn        DateTime?
  checkOut       DateTime?
  /// Present | Half day | Leave | Holiday | Work from home
  status         String   @default("Present")
  notes          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, date])
  @@index([organizationId, date])
  @@index([organizationId, userId])
}

/// A GST credit note against a customer invoice (sales return, cancellation,
/// rate revision). It reduces the invoice's taxable value and the GST already
/// reported, and keeps its own serial series so the return can reference it.
model CreditNote {
  id                  String    @id @default(cuid())
  organizationId      String
  reference           String
  /// Original invoice reference (finance record), e.g. HT-INV-26-27-0007.
  invoiceReference    String    @default("")
  customerName        String    @default("")
  customerGstin       String    @default("")
  reason              String    @default("")
  amount              Decimal   @default(0) @db.Decimal(14, 2)
  currency            String    @default("INR")
  gstRate             Decimal   @default(0) @db.Decimal(5, 2)
  /// issued | applied | cancelled
  status              String    @default("issued")
  issuedOn            DateTime  @default(now())
  appliedAt           DateTime?
  /// Invoice that was reduced by this note, when it is applied.
  appliesToReference  String    @default("")
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([organizationId, issuedOn])
  @@index([organizationId, invoiceReference])
}

/// A marketing send to a group of records on one channel.
///
/// The campaign keeps its audience rule, not a frozen list of people, so the
/// preview and the send always agree. Every message it produces lands in the
/// outbox tagged with this campaign, which is where the delivery log reads
/// from — one honest record of what was actually sent.
model Campaign {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  channel        String    @default("email") // email | whatsapp
  subject        String    @default("")
  body           String    @default("")
  audienceModule String    @default("leads")
  /// JSON: { statuses: string[] }
  audience       String    @default("{}")
  status         String    @default("draft") // draft | sending | sent | failed | scheduled
  total          Int       @default(0)
  sent           Int       @default(0)
  failed         Int       @default(0)
  skipped        Int       @default(0)
  lastSentAt     DateTime?
  /// When set, the campaign is scheduled to send at this UTC time (instead of immediately).
  scheduledFor   DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

/// One settlement against a payable.
model PayablePayment {
  id             String    @id @default(cuid())
  organizationId String
  payableId      String
  amount         Decimal   @default(0) @db.Decimal(14, 2)
  paidOn         DateTime?
  method         String    @default("Bank transfer")
  referenceNo    String    @default("")
  note           String    @default("")
  createdById    String?
  createdAt      DateTime  @default(now())

  payable Payable @relation(fields: [payableId], references: [id], onDelete: Cascade)

  @@index([organizationId, paidOn])
  @@index([payableId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Inventory, group travel, visa paperwork and the B2B channel
// ─────────────────────────────────────────────────────────────────────────────

/// Rooms the agency holds under a hotel contract for a date window.
///
/// A rate plan says what a room costs. An allotment says how many rooms are
/// actually held, so a booking can be refused before the hotel has to refuse
/// the guest. `usedRooms` is moved by the booking endpoints, never edited by
/// hand, and availability is derived (totalRooms - usedRooms).
model HotelAllotment {
  id             String    @id @default(cuid())
  organizationId String
  hotelName      String
  city           String    @default("")
  roomType       String    @default("Deluxe")
  mealPlan       String    @default("CP")
  supplierName   String    @default("")
  /// Contract window, yyyy-mm-dd. Empty means open-ended.
  contractFrom   String    @default("")
  contractTo     String    @default("")
  totalRooms     Int       @default(0)
  usedRooms      Int       @default(0)
  costPrice      Decimal   @default(0) @db.Decimal(14, 2)
  sellingPrice   Decimal   @default(0) @db.Decimal(14, 2)
  currency       String    @default("INR")
  /// Rooms not sold this many days before arrival go back to the hotel.
  releaseDays    Int       @default(7)
  status         String    @default("Open") // Open | Released | Closed
  notes          String    @default("")
  createdById    String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, hotelName])
  @@index([organizationId, status])
  @@index([organizationId, city])
}

/// One traveller on a group trip.
///
/// The delegate list and the rooming list are the same rows seen two ways:
/// the manifest prints every traveller with their passport, and the rooming
/// list groups them by room number. Keeping one table means the two can never
/// disagree — which is exactly what a hotel check-in desk catches.
model GroupMember {
  id               String   @id @default(cuid())
  organizationId   String
  /// The groups-module record this traveller belongs to.
  groupRecordId    String
  name             String
  email            String   @default("")
  phone            String   @default("")
  passport         String   @default("")
  nationality      String   @default("")
  dateOfBirth      String   @default("")
  roomType         String   @default("Double") // Single | Double | Twin | Triple | Child
  roomNumber       String   @default("")
  sharingWith      String   @default("")
  bedPreference    String   @default("")
  dietary          String   @default("")
  emergencyContact String   @default("")
  status           String   @default("Confirmed") // Confirmed | Pending | Cancelled
  notes            String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  /// Real foreign keys: purging a group must take its delegate rows with it,
  /// or passports and phone numbers would be orphaned forever.
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group        Record       @relation(fields: [groupRecordId], references: [id], onDelete: Cascade)

  @@index([organizationId, groupRecordId])
  @@index([organizationId, status])
}

/// One document a visa application needs.
///
/// Created from a template the first time an application is opened, then
/// tracked per traveller: pending → received → verified.
model VisaChecklistItem {
  id             String    @id @default(cuid())
  organizationId String
  /// The visa-module record (one application, usually one traveller).
  recordId       String
  label          String
  required       Boolean   @default(true)
  status         String    @default("pending") // pending | received | verified | rejected
  note           String    @default("")
  attachmentId   String?
  receivedAt     DateTime?
  position       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, recordId])
  @@index([organizationId, status])
}

/// The commercial terms of a B2B agent.
///
/// Commission and credit are the two numbers that decide whether an agency can
/// safely sell through a partner, so they live together on the agent record.
model AgentAccount {
  id             String   @id @default(cuid())
  organizationId String
  /// The agents-module record (AGN-2401).
  recordId       String   @unique
  agencyName     String   @default("")
  contactName    String   @default("")
  creditLimit    Decimal  @default(0) @db.Decimal(14, 2)
  creditUsed     Decimal  @default(0) @db.Decimal(14, 2)
  creditDays     Int      @default(30)
  commissionType String   @default("percent") // percent | fixed
  commissionRate Decimal  @default(0) @db.Decimal(6, 3)
  kycStatus      String   @default("pending") // pending | submitted | verified | rejected
  kycNotes       String   @default("")
  panNumber      String   @default("")
  gstin          String   @default("")
  contractFrom   String   @default("")
  contractTo     String   @default("")
  status         String   @default("Active") // Active | Suspended | Inactive
  notes          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, kycStatus])
}

// ─────────────────────────────────────────────────────────────────────────────
// Team Chat — internal Slack-style messaging for the travel team
// ─────────────────────────────────────────────────────────────────────────────

/// A channel (#general, #sales) or a direct-message thread between two users.
model ChatChannel {
  id             String   @id @default(cuid())
  organizationId String
  name           String // "#general" or "" for DMs
  description    String   @default("")
  isPrivate      Boolean  @default(false)
  isDirect       Boolean  @default(false) // true = 1:1 DM thread
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members  ChatMember[]
  messages ChatMessage[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Membership of a user in a chat channel, with an unread pointer.
model ChatMember {
  id         String   @id @default(cuid())
  channelId  String
  userId     String
  lastReadAt DateTime @default(now())
  createdAt  DateTime @default(now())

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId])
  @@index([userId])
}

/// One message inside a chat channel.
model ChatMessage {
  id           String    @id @default(cuid())
  channelId    String
  senderId     String
  senderName   String
  senderAvatar String?
  body         String
  replyToId    String?
  edited       Boolean   @default(false)
  deletedAt    DateTime?
  reactions    String    @default("{}") // JSON: { "👍": ["userId1","userId2"] }
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

/// One commission earned on one booking made by an agent.
model AgentCommission {
  id               String    @id @default(cuid())
  organizationId   String
  agentAccountId   String
  bookingReference String    @default("")
  description      String    @default("")
  saleAmount       Decimal   @default(0) @db.Decimal(14, 2)
  /// Percent when commissionType is "percent", otherwise a flat amount.
  rate             Decimal   @default(0) @db.Decimal(6, 3)
  commissionType   String    @default("percent")
  amount           Decimal   @default(0) @db.Decimal(14, 2)
  currency         String    @default("INR")
  status           String    @default("Accrued") // Accrued | Approved | Paid | Cancelled
  paidOn           DateTime?
  notes            String    @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([organizationId, status])
  @@index([agentAccountId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Push Notifications — browser Web Push subscriptions (VAPID)
// ─────────────────────────────────────────────────────────────────────────────

/// A browser Web Push subscription for one user on one device.
/// One user may subscribe on multiple devices/browsers simultaneously.
model PushSubscription {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  endpoint       String   @unique
  p256dh         String
  auth           String
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Flight PNR Queue — airline reservations, ticketing deadlines and e-tickets
// ─────────────────────────────────────────────────────────────────────────────

/// A PNR (Passenger Name Record) held in the queue until ticketed.
///
/// Every GDS hold expires — the deadline is the most critical field here.
/// Once tickets are issued, the ticketNumbers JSON array carries the
/// e-ticket numbers and the status moves to "Ticketed".
model FlightPNR {
  id             String    @id @default(cuid())
  organizationId String
  /// Optional link to the bookings record this PNR belongs to.
  recordId       String?
  pnr            String    @default("")
  gds            String    @default("Amadeus") // Amadeus | Sabre | Galileo | Manual
  airline        String    @default("")
  route          String    @default("") // e.g. "DEL-DXB-DEL"
  departure      String    @default("") // ISO datetime string
  /// JSON array of { name, passport, dob } passenger objects
  passengers     String    @default("[]")
  fareType       String    @default("Economy") // Economy | Business | First
  /// When the PNR will be auto-cancelled if not ticketed — the most critical date
  ticketDeadline DateTime?
  status         String    @default("Active") // Active | Ticketed | Voided | Expired | Refunded
  /// JSON array of issued e-ticket numbers
  ticketNumbers  String    @default("[]")
  notes          String    @default("")
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, status])
  @@index([ticketDeadline])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cross-module relations, activity timeline, saved views, favourites, prefs
//
// These five models replace the inferred (name-matching) links the product
// used to rely on. A real travel agency's workflow is a chain: enquiry →
// quote → booking → invoice → visa → flight → hotel. Making those links
// explicit rows — not a guess — is what makes the journey rail, the customer
// 360 page, and cross-module reporting trustworthy in production.
// ─────────────────────────────────────────────────────────────────────────────

/// An explicit, typed link between two records across modules.
///
/// `kind` describes the relationship: "quoted" (lead → quotation),
/// "booked" (quotation → booking), "invoiced" (booking → invoice),
/// "visa_for" (booking → visa), "flight_for", "hotel_for", "transfer_for",
/// "paying_for" (customer → invoice), "escalated_to" (support → booking).
/// The pair (fromId, toId, kind) is unique so a link cannot be created twice.
model RecordRelation {
  id             String   @id @default(cuid())
  organizationId String
  fromId         String
  toId           String
  /// The semantic type of this link (quoted | booked | invoiced | visa_for |
  /// flight_for | hotel_for | transfer_for | paying_for | escalated_to | related)
  kind           String   @default("related")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, kind])
  @@index([organizationId, fromId])
  @@index([organizationId, toId])
  @@index([organizationId, kind])
}

/// One event in a record's activity timeline: a note, a call, an email, a
/// status change, a field change, a payment — anything a person or the system
/// did that matters to the record's story.
///
/// The audit log (AuditLog) tracks system events for compliance; RecordEvent
/// is the user-facing timeline that a person reads in the record sheet. They
/// are kept separate so deleting a timeline note does not tamper with the
/// audit trail, and so the audit log can stay terse.
model RecordEvent {
  id             String   @id @default(cuid())
  organizationId String
  recordId       String
  /// The user who performed the action, or null when the system did it.
  actorId        String?
  actorName     String   @default("System")
  /// note | call | email | whatsapp | status_change | field_change | payment |
  /// relation_added | relation_removed | created | imported
  type           String
  /// Human-readable body for notes, or a JSON diff for field changes.
  body           String   @default("")
  /// Structured metadata (field name → old/new value, call outcome, etc.).
  meta           String   @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, recordId, createdAt])
  @@index([organizationId, type])
}

/// A saved filter+sort+column configuration for one module, owned by one
/// person or shared across the team.
model SavedView {
  id             String   @id @default(cuid())
  organizationId String
  /// null = organisation-wide (built-in demo views); a user id = personal.
  userId         String?
  moduleId       String
  title          String
  /// JSON: { status, owner, branch, source, from, to, q, tab }
  filters        String   @default("{}")
  /// JSON: { field, order }
  sort           String   @default("{}")
  /// JSON: ["reference","name","status", ...] — visible columns
  columns        String   @default("[]")
  /// A layout hint: "table" | "board" | "cards"
  layout         String   @default("table")
  isDefault      Boolean  @default(false)
  isShared       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleId, title])
  @@index([organizationId, moduleId])
  @@index([organizationId, userId])
}

/// A star on a record or a module, so a person can pin what they reach for
/// every day.
model Favorite {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  /// "record" or "module"
  targetType     String
  /// The record id or the module id, depending on targetType.
  targetId       String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([organizationId, userId])
  @@index([organizationId, targetType])
}

/// Per-user UI preferences, stored server-side so they survive a device
/// switch and are consistent across sessions.
model Preference {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  key            String
  value          String   @default("")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, key])
  @@index([organizationId, userId])
}
