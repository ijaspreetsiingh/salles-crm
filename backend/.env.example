# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public base URL used for building absolute links in responses / emails.
APP_URL=http://localhost:4000
# Comma separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ─── Database (SQLite) ───────────────────────────────────────────────────────
# Local dev keeps the file inside ./data. Inside Docker it is /app/data/traveldesk.db
DATABASE_URL="file:./data/traveldesk.db"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Use long random strings in production (openssl rand -hex 48).
JWT_ACCESS_SECRET=change-me-access-secret-change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=40

# ─── Uploads ─────────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15

# ─── Seed ────────────────────────────────────────────────────────────────────
# When true the container seeds the demo organisation on boot if the DB is empty.
SEED_ON_START=true
# Credentials created by the seed script.
SEED_OWNER_EMAIL=owner@horizontravel.in
SEED_OWNER_PASSWORD=Traveldesk@123

# ─── AI assistant (optional) ─────────────────────────────────────────────────
# Provide an OpenAI-compatible endpoint to enable live AI replies.
# Without a key the assistant runs in deterministic demo mode.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
