# ─── Traveldesk Production Environment (.env) ───
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# Generate strong secrets with: openssl rand -hex 32
#

# ─── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
# Your primary domain (used by setup.sh to configure nginx + SSL)
DOMAIN=yourdomain.com
# Public URL of your API (used in emails, links, etc.)
APP_URL=https://api.yourdomain.com
# Public URL of your frontend (used in password-reset links, etc.)
FRONTEND_URL=https://yourdomain.com
# Where customer portal links should open (defaults to FRONTEND_URL)
PORTAL_URL=https://yourdomain.com
# Allowed CORS origins (comma-separated, no spaces)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Session cookie policy: "lax" when app + API share a site (app.x.com + api.x.com).
# Use "none" when they are on different sites (e.g. Netlify frontend + Render API).
AUTH_COOKIE_SAME_SITE=lax

# ─── Database (PostgreSQL recommended for production) ─────────────────────
# PostgreSQL only — money uses DECIMAL(14,2), which SQLite cannot represent
DATABASE_URL=postgres://traveldesk:CHANGE_ME@postgres:5432/traveldesk
POSTGRES_USER=traveldesk
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=traveldesk
POSTGRES_PORT=5432
DATABASE_PROVIDER=postgres

# ─── Auth (REQUIRED: generate strong secrets) ─────────────────────────────
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_32_CHARS_MIN_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_32_CHARS_MIN_REFRESH_SECRET
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Company admins, branch managers and finance must enrol an authenticator app
# (TOTP) before they can use the workspace. On by default in production;
# set to false only for a staging box where nobody has a phone.
TWO_FACTOR_ENFORCEMENT=true

# Refuse a password sign-in until the email address is verified. On by default
# in production; existing sessions close when their refresh token is used.
REQUIRE_EMAIL_VERIFICATION=true

# Cloudflare Turnstile on the public lead form (optional, both or neither).
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# ─── Rate Limiting ────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5000
AUTH_RATE_LIMIT_MAX=10

# ─── GST e-invoicing (optional) ───────────────────────────────────────────
# Generate an IRN for B2B invoices through your GSP. Leave blank while you are
# not registered — invoices print without an IRN instead of with a fake one.
# IRP_SANDBOX must be set explicitly: "true" for the NIC sandbox, "false" for live.
GSP_USERNAME=
GSP_PASSWORD=
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=
GSTIN=
IRP_SANDBOX=
# The per-session Sek is negotiated automatically; no fixed test key is used.

# ─── Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=15

# ─── Seed (set to false in production after initial setup) ────────────────
SEED_ON_START=false
SEED_DEMO=false
SEED_OWNER_EMAIL=owner@yourdomain.com
SEED_OWNER_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SEED_SUPER_ADMIN_EMAIL=superadmin@yourdomain.com
SEED_SUPER_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── Platform Admin (can access /admin portal) ────────────────────────────
PLATFORM_ADMIN_EMAILS=admin@yourdomain.com

# ─── AI Assistant (optional) ──────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# ─── Email (SMTP - required for real email delivery) ──────────────────────
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Traveldesk <noreply@yourdomain.com>

# ─── WhatsApp Business Cloud API (optional) ───────────────────────────────
WHATSAPP_TOKEN=...
WHATSAPP_PHONE_NUMBER_ID=...
# Meta app secret — verifies X-Hub-Signature-256 on inbound webhooks (required in production)
WHATSAPP_APP_SECRET=...
# Random string Meta echoes during webhook verification
WHATSAPP_VERIFY_TOKEN=...
# Shared secret for inbound email webhooks (required in production)
INBOUND_EMAIL_SECRET=...

# ─── Payments / Razorpay (optional) ───────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# ─── Flight Search / Amadeus (optional) ───────────────────────────────────
AMADEUS_CLIENT_ID=...
AMADEUS_CLIENT_SECRET=...
AMADEUS_HOST=https://api.amadeus.com

# ─── Hotel Search / Hotelbeds (optional) ──────────────────────────────────
# Sign up free at https://developer.hotelbeds.com
# Leave empty to use your contract rates as fallback.
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
# "sandbox" for testing, "production" for live
HOTELBEDS_ENV=sandbox

# ─── Backup Encryption (optional but recommended) ─────────────────────────
# ─── Schedulers & scale ──────────────────────────────────────────────────────
# The digest and follow-up schedulers run inside the API process. On a
# multi-node deployment keep them enabled on exactly one node and set
# RUN_SCHEDULERS=false everywhere else, so no email is sent twice.
RUN_SCHEDULERS=true
# Optional: bridges socket.io across API instances.
REDIS_URL=

# ─── Monitoring ───────────────────────────────────────────────────────────
# GET /api/v1/metrics returns Prometheus text (requests, errors, latency,
# memory). Set a token to expose it through a reverse proxy:
#   curl -H "Authorization: Bearer $METRICS_TOKEN" https://api.../metrics
# Empty = served in development, hidden in production.
METRICS_TOKEN=

# Encrypts backup files at rest. PostgreSQL backups use pg_dump (the runtime
# image already includes the client); SQLite backs up the .db file.
BACKUP_ENCRYPTION_KEY=CHANGE_ME_32_CHARS_MIN
BACKUPS_TO_KEEP=14

# ─── SSL / Domain ─────────────────────────────────────────────────────────
SSL_DOMAIN=yourdomain.com
SSL_EMAIL=you@yourdomain.com

# ─── Browser Push Notifications / VAPID (optional) ────────────────────────────
# Generate keys once: npx web-push generate-vapid-keys
# Then paste the output below. VAPID_PUBLIC_KEY is exposed to the frontend.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ─── Error reporting & alerting (optional) ──────────────────────────────────
# Sentry DSN — exceptions are posted to Sentry's envelope API when set.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=

# Slack / Teams incoming webhook (anything that accepts {"text": "..."}).
# A 5xx on the API, a crash, or a dead-lettered automation posts here, throttled
# per title to one message per ALERT_MIN_INTERVAL_MS.
ALERT_WEBHOOK_URL=
ALERT_MIN_INTERVAL_MS=300000

# ─── Malware scanning (optional, recommended for real documents) ────────────
# Address of a clamd daemon. docker-compose.prod.yml runs one as `clamav`.
# Empty = only the EICAR test signature is rejected, and the UI marks every
# upload "Not virus-scanned" instead of pretending it was checked.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000
