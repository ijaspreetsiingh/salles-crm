# ─── Traveldesk Production Environment (.env) ───
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# Generate strong secrets with: openssl rand -hex 32
#

# ─── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
# Public URL of your API (used in emails, links, etc.)
APP_URL=https://api.yourdomain.com
# Allowed CORS origins (comma-separated, no spaces)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ─── Database (PostgreSQL recommended for production) ─────────────────────
# Use SQLite for dev, PostgreSQL for production
DATABASE_URL=postgres://traveldesk:CHANGE_ME@postgres:5432/traveldesk
POSTGRES_USER=traveldesk
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=traveldesk
POSTGRES_PORT=5432
DATABASE_PROVIDER=postgres

# ─── Auth (REQUIRED: generate strong secrets) ─────────────────────────────
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_32_CHARS_MIN_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_32_CHARS_MIN_REFRESH_SECRET
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ─── Rate Limiting ────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5000
AUTH_RATE_LIMIT_MAX=40

# ─── Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=15

# ─── Seed (set to false in production after initial setup) ────────────────
SEED_ON_START=false
SEED_OWNER_EMAIL=owner@yourdomain.com
SEED_OWNER_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SEED_SUPER_ADMIN_EMAIL=superadmin@yourdomain.com
SEED_SUPER_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── Platform Admin (can access /admin portal) ────────────────────────────
PLATFORM_ADMIN_EMAILS=admin@yourdomain.com

# ─── AI Assistant (optional) ──────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# ─── Email (SMTP - required for real email delivery) ──────────────────────
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Traveldesk <noreply@yourdomain.com>

# ─── WhatsApp Business Cloud API (optional) ───────────────────────────────
WHATSAPP_TOKEN=...
WHATSAPP_PHONE_NUMBER_ID=...

# ─── Payments / Razorpay (optional) ───────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# ─── Flight Search / Amadeus (optional) ───────────────────────────────────
AMADEUS_CLIENT_ID=...
AMADEUS_CLIENT_SECRET=...
AMADEUS_HOST=https://api.amadeus.com

# ─── Backup Encryption (optional but recommended) ─────────────────────────
# Encrypts backup files at rest
BACKUP_ENCRYPTION_KEY=CHANGE_ME_32_CHARS_MIN
BACKUPS_TO_KEEP=14

# ─── SSL / Domain ─────────────────────────────────────────────────────────
SSL_DOMAIN=yourdomain.com
SSL_EMAIL=you@yourdomain.com
